# Server
PORT=3000

# PostgreSQL
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="lawlibra"
DB_USER="postgres"
DB_PASSWORD="yourpassword"

# JWT
JWT_SECRET="your_super_secret_key_minimum_32_chars_change_this"
JWT_EXPIRES_IN="8h"

# Redis (BullMQ job queue — run via Docker: docker run -p 6379:6379 redis:alpine)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=

# Google AI (for text-embedding-004 — remove after migrating to local Ollama)
GOOGLE_API_KEY="your_google_api_key_here"

# File Storage
# DATA_DIR: root of the case/folder/document hierarchy on disk
# Switch to an S3 bucket name + update storage.utils.mjs when ready
DATA_DIR="data"
# UPLOAD_TEMP_DIR: multer staging area before file is moved to final destination
UPLOAD_TEMP_DIR="uploads/tmp"
