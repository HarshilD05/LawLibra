# ====================================================================================
# 1. SERVER & AUTHENTICATION
# ====================================================================================
PORT=3000

# Authentication (Minimum 32 characters for security)
JWT_SECRET="your_super_secret_key_minimum_32_chars_change_this"
JWT_EXPIRES_IN="8h"

# ====================================================================================
# 2. DATABASE SETUP
# ====================================================================================
# PostgreSQL connection details (requires pgvector extension)
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="lawlibra"
DB_USER="postgres"
DB_PASSWORD="yourpassword"

# ====================================================================================
# 3. LLM PROVIDER SETUP
# ====================================================================================
# Supported choices: gemini | groq | openai | anthropic | ollama
LLM_PROVIDER="gemini"

# Optional model override. Uses provider default from factory if left empty.
# Examples: gemini-2.5-flash, llama-3.3-70b-versatile, gpt-4o-mini
LLM_MODEL=""

# Provider API keys (populate only the one you plan to use)
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# RAG cosine similarity floor (0.0 to 1.0). Higher = stricter relevance.
RAG_SIMILARITY_THRESHOLD=0.65

# ====================================================================================
# 4. EMBEDDING SETUP
# ====================================================================================
# Provider options: google | ollama_local | external
# Note: EMBEDDING_DIMENSIONS must be 768 to match the DB schema.
EMBEDDING_METHOD="ollama_local"
EMBEDDING_BATCH_SIZE=100
EMBEDDING_DIMENSIONS=768

# Google configuration
GOOGLE_EMBEDDING_API_KEY="your_google_api_key_here"

# Local configuration (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# External configuration
EXTERNAL_EMBEDDING_ENDPOINT=""
EXTERNAL_EMBEDDING_API_KEY=""

# ====================================================================================
# 5. DOCUMENT INGESTION & REDIS
# ====================================================================================
# Method options: bullmq (prod) | spawn (simple) | sync (dev only)
DOC_INGESTION_METHOD="sync"

# Redis Server (ONLY required when DOC_INGESTION_METHOD="bullmq")
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ====================================================================================
# 6. FILE STORAGE SETUP
# ====================================================================================
# DATA_DIR: Disk root for cases/folders hierarchy
DATA_DIR="data"
# UPLOAD_TEMP_DIR: Temporary Multer staging location
UPLOAD_TEMP_DIR="uploads/tmp"