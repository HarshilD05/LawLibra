# Server
PORT=3000

# PostgreSQL
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="lawlibra"
DB_USER="postgres"
DB_PASSWORD="yourpassword"

# JWT
JWT_SECRET="your_super_secret_key_minimum_32_chars_change_this"
JWT_EXPIRES_IN="8h"

# Document Ingestion Method
# bullmq  — requires Redis + the worker process (npm run worker) — production recommended
# spawn   — forks a child process per document; no Redis needed
# sync    — runs ingestion inline/blocking; simplest, for development/testing only
DOC_INGESTION_METHOD="sync"

# Redis (required only when DOC_INGESTION_METHOD=bullmq)
# Run via Docker: docker run -p 6379:6379 redis:alpine
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=

# Google AI (for text-embedding-004 — remove after migrating to local Ollama)
GOOGLE_EMBEDDER_API_KEY="your_google_api_key_here"

# File Storage
# DATA_DIR: root of the case/folder/document hierarchy on disk
# Switch to an S3 bucket name + update storage.utils.mjs when ready
DATA_DIR="data"
# UPLOAD_TEMP_DIR: multer staging area before file is moved to final destination
UPLOAD_TEMP_DIR="uploads/tmp"

# RAG + LLM Configuration
# LLM_PROVIDER supported: gemini | groq | openai | anthropic | ollama
# Default in code: gemini
LLM_PROVIDER="gemini"

# Optional model override. If empty, provider defaults from llm_factory.mjs are used.
# Examples:
# - gemini: gemini-2.0-flash
# - groq: llama-3.3-70b-versatile
# - openai: gpt-4o-mini
# - anthropic: claude-3-5-haiku-20241022
# - ollama: llama3.2
LLM_MODEL=""

# Provider API keys (set only for provider(s) you use)
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# RAG retrieval tunable (cosine similarity threshold: 0.0 to 1.0)
# Higher = stricter relevance, lower = broader recall
RAG_SIMILARITY_THRESHOLD=0.65